+// Set the current process's bounded base scheduling priority.
+int
+ksetpriority(int priority)
+{
+  struct proc *p = myproc();
+
+  if (priority < PRIORITY_MIN || priority > PRIORITY_MAX)
+    return -1;
+  acquire(&p->lock);
+  p->priority = priority;
+  p->wait_rounds = 0;
+  release(&p->lock);
+  return 0;
+}
